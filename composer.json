{
	"name": "everpress/mailster-google-analytics",
	"description": "Dev dependencies for Mailster Google Analytics",
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"scripts": {
		"check-cs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
		"fix-cs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
